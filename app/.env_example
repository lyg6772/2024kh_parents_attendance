# SQLite (로컬 개발) 또는 Oracle (운영)
# SQLite 예시: sqlite+aiosqlite:///app/local.db
# Oracle 예시: (비워두면 아래 DB_USER/DB_PW/ORACLE_CONNECTION_STRING 조합)
DB_URL=

DB_HOST=
DB_USER=
DB_PW=
DB_PORT=
DB_DB=
ORACLE_CONNECTION_STRING=
SECRET_SALT=
ACCESS_TOKEN_EXPIRE_HOURS=8
GROQ_API_KEY=
# 콤마 구분 후보 목록, 앞에서부터 순서대로 시도(모델 폐기/레이트리밋 시 다음으로 자동 전환)
GROQ_MODEL=qwen/qwen3.8-27b,qwen/qwen3.6-27b,openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash